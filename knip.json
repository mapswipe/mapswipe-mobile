{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "graphql-codegen": false,
    "entry": [
        "app/**/*.{ts,tsx}",
        "codegen.ts",
        "plugins/**",
        "utils/firebase-generated-types.ts",
        "__tests__/**/*.test.{ts,tsx}",
        "scripts/**/*.ts",
        "components/ui/**/*.{ts,tsx}"
    ],
    "ignoreFiles": [
        "metro.config.js",
        "backend/**",
        "generated/**",
        "**/*.web.{ts,tsx}",
        "components/BaseMap.tsx",
        "components/GeoJsonMapSource.tsx",
        "jest.config.cjs",
        "jest/babel.config.cjs",
        "constants/answers.ts",
        "constants/border.ts",
        "constants/elevation.ts",
        "constants/layer.ts",
        "constants/motion.ts",
        "constants/opacity.ts",
        "constants/radius.ts",
        "constants/size.ts",
        "utils/layout.ts",
        "hooks/useA11yPreferences.ts",
        "hooks/useFittedTileWidth.ts",
        "hooks/useViewport.ts"
    ],
    "ignoreMembers": [
        "FbTask"
    ],
    "ignoreUnresolved": [
        "babel-jest",
        "@expo/vector-icons"
    ],
    "ignoreDependencies": [
        "expo-updates",
        "expo-splash-screen",
        "jest-watch-typeahead",
        "@firebase/auth",
        "@togglecorp/re-map",
        "@expo/metro-config",
        "metro-minify-terser",
        "dotenv",
        "@graphql-codegen/introspection",
        "@graphql-codegen/typescript",
        "@graphql-codegen/typescript-operations",
        "@graphql-codegen/typescript-urql",
        "@typescript-eslint/eslint-plugin",
        "eslint-config-airbnb",
        "eslint-plugin-import-newlines",
        "eslint-plugin-jsx-a11y",
        "eslint-plugin-react",
        "eslint-plugin-react-hooks",
        "eslint-plugin-react-native",
        "eslint-plugin-simple-import-sort"
    ],
    "rules": {
        "exports": "warn",
        "types": "warn"
    },
    "treatConfigHintsAsErrors": false
}
