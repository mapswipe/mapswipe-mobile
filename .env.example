# Local development only: use the local firebase emulators (eg. started with the backend's docker compose)
# Eg. localhost:9000 and localhost:9099. On Android, also run `adb reverse tcp:9000 tcp:9000` (and 9099)
EXPO_PUBLIC_FIREBASE_DATABASE_EMULATOR_HOST=
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
