{
    "name": "mapswipe-mobile",
    "main": "expo-router/entry",
    "version": "3.0.0",
    "type": "module",
    "scripts": {
        "start": "expo start",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "web": "expo start --web",
        "prebuild": "expo prebuild",
        "prebuild:clean": "expo prebuild --clean",
        "build:debug": "pnpm prebuild && cd android && ./gradlew assembleDebug && cd .. && ts-node -P tsconfig.scripts.json scripts/copy-apk.ts debug",
        "build:release": "pnpm prebuild && cd android && ./gradlew assembleRelease && cd .. && ts-node -P tsconfig.scripts.json scripts/copy-apk.ts release",
        "clean:gradle": "cd android && ./gradlew clean",
        "clean:build": "rm -rf android ios",
        "clean:generated": "rm -rf generated",
        "generate:type": "graphql-codegen --require dotenv/config --config codegen.ts dotenv_config_path=.env.local",
        "clean:all": "pnpm clean:build && pnpm clean:generated",
        "prelint": "pnpm generate:type",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:unused": "knip --tags=-knipignore",
        "typecheck": "tsc --noEmit",
        "check": "pnpm run typecheck && pnpm run lint"
    },
    "dependencies": {
        "@expo/metro-runtime": "~56.0.15",
        "@mapbox/tilebelt": "^2.0.3",
        "@maplibre/maplibre-react-native": "^10.4.2",
        "@react-native-async-storage/async-storage": "^2.2.0",
        "@symbiot.dev/react-native-heatmap": "^1.0.0",
        "@togglecorp/fujs": "^2.2.0",
        "@togglecorp/re-map": "^1.0.0",
        "@turf/bbox": "^7.3.1",
        "base-64": "^1.0.0",
        "date-fns": "^4.1.0",
        "expo": "~56.0.11",
        "expo-checkbox": "^56.0.1",
        "expo-constants": "~56.0.18",
        "expo-dev-client": "~56.0.20",
        "expo-image": "~56.0.11",
        "expo-linking": "~56.0.14",
        "expo-router": "~56.2.10",
        "expo-splash-screen": "~56.0.10",
        "expo-status-bar": "~56.0.4",
        "expo-system-ui": "~56.0.5",
        "expo-web-browser": "~56.0.5",
        "firebase": "^12.6.0",
        "i18next": "^25.8.17",
        "i18next-resources-to-backend": "^1.2.1",
        "pako": "^2.1.0",
        "phosphor-react-native": "^3.0.2",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-i18next": "^16.5.7",
        "react-native": "0.85.3",
        "react-native-enriched-markdown": "^0.5.0",
        "react-native-gesture-handler": "^2.31.2",
        "react-native-reanimated": "~4.3.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "~4.25.2",
        "react-native-svg": "15.15.4",
        "react-native-toast-message": "^2.3.3",
        "react-native-web": "~0.21.2",
        "react-native-webview": "^13.16.1",
        "react-native-worklets": "0.8.3",
        "urql": "^5.0.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.3",
        "@eslint/js": "^9.39.2",
        "@graphql-codegen/cli": "^6.2.1",
        "@graphql-codegen/introspection": "^5.0.1",
        "@graphql-codegen/typescript": "^5.0.9",
        "@graphql-codegen/typescript-operations": "^5.0.9",
        "@graphql-codegen/typescript-urql": "^5.0.0",
        "@types/base-64": "^1.0.2",
        "@types/node": "^25.2.1",
        "@types/pako": "^2.0.4",
        "@types/react": "~19.2.17",
        "@typescript-eslint/eslint-plugin": "^8.54.0",
        "@typescript-eslint/parser": "^8.54.0",
        "dotenv": "^17.4.2",
        "eslint": "^9.39.2",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-import-newlines": "^1.4.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-native": "^5.0.0",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "firebase-admin": "^13.6.1",
        "knip": "^5.83.0",
        "ts-node": "^10.9.2",
        "typescript": "~6.0.3"
    },
    "engines": {
        "node": "22",
        "pnpm": "10.6.1"
    },
    "packageManager": "pnpm@10.6.1+sha512.40ee09af407fa9fbb5fbfb8e1cb40fbb74c0af0c3e10e9224d7b53c7658528615b2c92450e74cfad91e3a2dcafe3ce4050d80bda71d757756d2ce2b66213e9a3",
    "private": true
}
