{
    "expo": {
        "name": "MapSwipe",
        "slug": "mapswipe-mobile",
        "version": "3.0.1",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "mapswipemobile",
        "newArchEnabled": true,
        "backgroundColor": "#0D1949",
        "userInterfaceStyle": "light",
        "ios": {
            "bundleIdentifier": "org.missingmaps.mapswipe",
            "buildNumber": "0",
            "backgroundColor": "#0D1949",
            "supportsTablet": true,
            "infoPlist": {
                "ITSAppUsesNonExemptEncryption": false
            }
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/adaptive-icon.png",
                "backgroundColor": "#0D1949"
            },
            "predictiveBackGestureEnabled": false,
            "package": "org.missingmaps.mapswipe",
            "versionCode": 3000100,
            "userInterfaceStyle": "light"
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            "expo-system-ui",
            "@maplibre/maplibre-react-native",
            "./plugins/disable-liquid-glass.cjs",
            "./plugins/strip-unused-permissions.cjs",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 150,
                    "resizeMode": "contain",
                    "backgroundColor": "#0D1949"
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true
        }
    }
}
