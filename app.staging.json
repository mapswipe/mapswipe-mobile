{
    "expo": {
        "name": "MapSwipe Dev",
        "slug": "mapswipe-mobile-staging",
        "version": "3.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "devmapswipe",
        "newArchEnabled": true,
        "backgroundColor": "#0D1949",
        "userInterfaceStyle": "light",
        "ios": {
            "bundleIdentifier": "org.missingmaps.mapswipe-dev",
            "buildNumber": "7",
            "backgroundColor": "#0D1949",
            "supportsTablet": true,
            "infoPlist": {
                "ITSAppUsesNonExemptEncryption": false,
                "NSLocationWhenInUseUsageDescription": "MapSwipe uses your location to show your position on the map while mapping."
            }
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/adaptive-icon.png",
                "backgroundColor": "#ffaa00"
            },
            "predictiveBackGestureEnabled": false,
            "package": "org.missingmaps.mapswipe.dev",
            "userInterfaceStyle": "light"
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            "expo-system-ui",
            "@maplibre/maplibre-react-native",
            "./plugins/disable-liquid-glass.cjs",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#0D1949"
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true
        }
    }
}
